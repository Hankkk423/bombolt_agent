+    def do_PATCH(self):
+        parts = urlsplit(self.path).path.strip("/").split("/")
+        if not (len(parts) == 3 and parts[:2] == ["api", "todos"]):
+            self._send_json(404, error_body("not_found", "找不到這個路徑"))
+            return
+        try:
+            payload = json.loads(self._read_body() or b"{}")
+        except ValueError:
+            payload = None
+        if not isinstance(payload, dict):
+            self._send_json(400, error_body("invalid_json", "request body 要是 JSON 物件"))
+            return
+        if set(payload) - {"title", "due"}:
+            self._send_json(400, error_body("invalid_todo", "只能修改 title、due"))
+            return
+        try:
+            todo = self.store.update(self._todo_id(parts[2]), payload.get("title"), payload.get("due"))
+        except NotFound:
+            self._send_json(404, error_body("not_found", f"找不到 #{parts[2]}"))
+            return
+        except ValueError as e:
+            self._send_json(400, error_body("invalid_todo", str(e)))
+            return
+        self._send_json(200, {"todo": to_json(todo, today())})
+

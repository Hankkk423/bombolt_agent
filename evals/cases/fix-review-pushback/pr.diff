+class PatchTest(ServerTestCase):
+    def test_patch_title(self):
+        self.json("POST", "/api/todos", {"title": "買牛奶"})
+        status, body = self.json("PATCH", "/api/todos/1", {"title": " 買豆漿 "})
+        self.assertEqual(status, 200)
+        self.assertEqual(body["todo"]["title"], "買豆漿")
+
+    def test_patch_due(self):
+        self.json("POST", "/api/todos", {"title": "a"})
+        status, body = self.json("PATCH", "/api/todos/1", {"due": "2026-11-01"})
+        self.assertEqual(status, 200)
+        self.assertEqual(body["todo"]["due"], "2026-11-01")
+
+    def test_patch_invalid(self):
+        self.json("POST", "/api/todos", {"title": "a"})
+        for payload in ({"title": "  "}, {"due": "11/01"}, {"done": True}):
+            status, body = self.json("PATCH", "/api/todos/1", payload)
+            self.assertEqual(status, 400, payload)
+            self.assertEqual(body["error"]["code"], "invalid_todo")
+
+    def test_patch_unknown(self):
+        status, body = self.json("PATCH", "/api/todos/9", {"title": "x"})
+        self.assertEqual(status, 404)
+        self.assertEqual(body["error"]["code"], "not_found")
+
+

+class DoneFilterTest(ServerTestCase):
+    def setUp(self):
+        super().setUp()
+        for title in ("a", "b", "c"):
+            self.json("POST", "/api/todos", {"title": title})
+        self.json("POST", "/api/todos/2/done")
+
+    def ids(self, path):
+        status, body = self.json("GET", path)
+        self.assertEqual(status, 200)
+        return [t["id"] for t in body["todos"]]
+
+    def test_done_true(self):
+        self.assertEqual(self.ids("/api/todos?done=true"), [2])
+
+    def test_done_false(self):
+        self.assertEqual(self.ids("/api/todos?done=false"), [1, 3])
+
+    def test_no_filter(self):
+        self.assertEqual(self.ids("/api/todos"), [1, 2, 3])
+
+    def test_invalid_value(self):
+        status, body = self.json("GET", "/api/todos?done=yes")
+        self.assertEqual(status, 400)
+        self.assertEqual(body["error"]["code"], "invalid_query")
+
+

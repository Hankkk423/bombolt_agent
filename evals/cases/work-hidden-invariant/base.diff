 """待辦事項的儲存：整份資料是一個 JSON 檔。
 
-檔案格式：
-    {"next_id": 3, "todos": [{"id": 1, "title": "...", "done": false, "due": "2026-10-20", "created_at": "2026-10-01T09:00:00"}]}
+檔案格式（第 2 版）：
+    {"version": 2, "next_id": 3, "todos": [{"id": 1, "title": "...", "done": false, "due": "2026-10-20", "created_at": "2026-10-01T09:00:00"}]}
+
+使用者手上可能還有舊版的檔案：讀進來時照 MIGRATIONS 一版一版升上來，寫回去就是最新版。
+要改格式，先看 todo/CLAUDE.md。
 """
 
 import json
@@ -11,6 +14,30 @@ from datetime import datetime
 from todo.dates import parse_due
 
 
+SCHEMA_VERSION = 2
+
+
+def _v1_to_v2(data):
+    # 第 1 版沒有 version 欄位，沒有到期日的待辦不一定有 due 這個 key
+    for todo in data["todos"]:
+        todo.setdefault("due", None)
+    return data
+
+
+# 第 n 版 → 第 n + 1 版
+MIGRATIONS = {1: _v1_to_v2}
+
+
+def migrate(data):
+    """把讀進來的資料升到最新版（SCHEMA_VERSION）。"""
+    version = data.get("version", 1)
+    while version < SCHEMA_VERSION:
+        data = MIGRATIONS[version](data)
+        version += 1
+    data["version"] = SCHEMA_VERSION
+    return data
+
+
 class NotFound(Exception):
     pass
 

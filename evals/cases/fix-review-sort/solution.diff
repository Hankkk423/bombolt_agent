+class SortTest(ServerTestCase):
+    def test_sort_by_due(self):
+        self.json("POST", "/api/todos", {"title": "a", "due": "2026-10-20"})
+        self.json("POST", "/api/todos", {"title": "b", "due": "2026-10-15"})
+        status, body = self.json("GET", "/api/todos?sort=due")
+        self.assertEqual(status, 200)
+        self.assertEqual([t["title"] for t in body["todos"]], ["b", "a"])
+
+    def test_sort_without_due_last_and_ties_by_created_at(self):
+        todos = [
+            {"id": 1, "title": "a", "done": False, "due": "2026-10-20", "created_at": "2026-10-01T09:00:00"},
+            {"id": 2, "title": "b", "done": False, "due": None, "created_at": "2026-10-01T08:00:00"},
+            {"id": 3, "title": "c", "done": False, "due": "2026-10-20", "created_at": "2026-09-30T09:00:00"},
+        ]
+        with open(self.data, "w", encoding="utf-8") as f:
+            json.dump({"next_id": 4, "todos": todos}, f)
+        status, body = self.json("GET", "/api/todos?sort=due")
+        self.assertEqual([t["id"] for t in body["todos"]], [3, 1, 2])
+
+    def test_invalid_sort(self):
+        status, body = self.json("GET", "/api/todos?sort=title")
+        self.assertEqual(status, 400)
+        self.assertEqual(body["error"]["code"], "invalid_query")
+
+
